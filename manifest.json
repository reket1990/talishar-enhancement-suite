{
  "manifest_version": 3,
  "name": "Talishar Enhancement Suite",
  "version": "1.0.0",
  "description": "Enhancements for talishar.net.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Talishar Enhancement Suite",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://talishar.net/*", "https://*.talishar.net/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://talishar.net/*", "https://*.talishar.net/*"]
}
